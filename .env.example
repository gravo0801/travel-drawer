# Firebase (Project settings > General > Your apps > Web app). Leave empty to run without Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# PDF로 글 올리기 (/admin/import) — 서버 전용, NEXT_PUBLIC 붙이지 말 것
ANTHROPIC_API_KEY=            # console.anthropic.com 에서 발급
ANTHROPIC_MODEL=claude-sonnet-5-5
GITHUB_TOKEN=                 # Fine-grained token: travel-drawer 저장소, Contents = Read and write
GITHUB_REPO=gravo0801/travel-drawer
GITHUB_BRANCH=main
ADMIN_UIDS=                   # /admin 에서 로그인 후 보이는 UID (여러 명이면 쉼표로)
