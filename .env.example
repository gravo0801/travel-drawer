# Firebase (Project settings > General > Your apps > Web app). Leave empty to run without Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Show the sample archive entries until all 849 posts are migrated
NEXT_PUBLIC_SHOW_SAMPLES=true
